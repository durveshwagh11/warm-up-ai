{
  "name": "mock-interview",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "cd frontend && next dev",
    "dev:backend": "cd backend && npm run start:dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && next build",
    "build:backend": "cd backend && npm run build",
    "start": "npm run start:frontend",
    "start:frontend": "cd frontend && next start",
    "start:backend": "cd backend && npm start",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && next lint",
    "lint:backend": "cd backend && eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "npm run lint:fix:frontend && npm run lint:fix:backend",
    "lint:fix:frontend": "cd frontend && next lint --fix",
    "lint:fix:backend": "cd backend && eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "db:push": "cd backend && npm run db:push",
    "db:studio": "cd backend && npm run db:studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.1.5",
    "@google/generative-ai": "^0.12.0",
    "@neondatabase/serverless": "^0.9.3",
    "@nextui-org/navbar": "^2.0.33",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.31.2",
    "framer-motion": "^11.2.12",
    "lucide-react": "^0.395.0",
    "moment": "^2.30.1",
    "next": "14.2.4",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-speech-to-text": "^0.8.0",
    "react-router": "^6.23.1",
    "react-webcam": "^7.2.0",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "drizzle-kit": "^0.22.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.14",
    "postcss": "^8",
    "prettier": "^3.8.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
